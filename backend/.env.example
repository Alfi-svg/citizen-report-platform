# ===================================================
# Bangladesh Citizen Report Platform — Environment Config
# ===================================================

# Environment mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Bangladesh Citizen Report Platform"
VERSION="0.1.0"

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citizen_report_db

# Storage Configuration (S3 / Cloud-compatible object storage)
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=citizen-report-media
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT_URL=http://localhost:9000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
