# ==============================================================================
# Bangladesh Citizen Report Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - NEVER commit real credentials, passwords, or JWT secrets to source control.
# - SERVER-ONLY variables must only be supplied to backend processes.
# - PUBLIC variables (NEXT_PUBLIC_*) are exposed to the client-side bundle.
# ==============================================================================

# ==============================================================================
# 1. DATABASE
# ==============================================================================
# PostgreSQL Async Connection String (Required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# For managed SSL PostgreSQL (e.g. AWS RDS, Supabase, Neon, Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@db.example.com:5432/citizen_report_db?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citizen_report_db

# Connection Pool Settings
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=10

# ==============================================================================
# 2. AUTH
# ==============================================================================
# JWT Secret Key for cryptographic token signing (Required in Production, min 32 characters)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars

# JWT Access Token Lifespan in minutes (Default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Admin Bootstrap Configuration (Optional CLI environment overrides)
ADMIN_EMAIL=admin@citizenreport.gov.bd
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
ADMIN_NAME="Lead Administrator"

# ==============================================================================
# 3. BACKEND
# ==============================================================================
# Backend bind host and listening port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# API Version URI prefix
API_V1_STR=/api/v1

# Logging verbosity: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
LOG_LEVEL=INFO

# ==============================================================================
# 4. FRONTEND
# ==============================================================================
# Public backend API endpoint URL (Browser-accessible)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Canonical web application base URL (Browser-accessible)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 5. CORS
# ==============================================================================
# Comma-separated or JSON list of authorized frontend origins.
# Wildcard '*' is strictly prohibited when credentials are enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# 6. STORAGE
# ==============================================================================
# Storage driver: "local" (filesystem) or "s3" (AWS S3, Cloudflare R2, MinIO, Wasabi)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage

# S3 Configuration (Required when STORAGE_BACKEND=s3)
STORAGE_BUCKET=citizen-report-evidence
STORAGE_ENDPOINT=https://your-s3-endpoint.example.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder

# Upload Size Limits (in bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=52428800
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_MEDIA_PER_REPORT=10

# ==============================================================================
# 7. OTHER REQUIRED CONFIGURATION
# ==============================================================================
# Environment Mode: "development", "staging", or "production"
ENVIRONMENT=development

# Project branding metadata
PROJECT_NAME="Bangladesh Citizen Report Platform"
VERSION="0.1.0"

# Interactive Swagger/OpenAPI docs toggle (Defaults to true in dev, false in prod)
# ENABLE_DOCS=false


