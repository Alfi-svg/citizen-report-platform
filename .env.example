# ==============================================================================
# Bangladesh Citizen Report Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - NEVER commit real credentials, passwords, or JWT secrets to source control.
# - SERVER-ONLY variables must only be supplied to backend processes.
# - PUBLIC variables (NEXT_PUBLIC_*) are exposed to the client-side bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Environment: "development", "staging", or "production"
ENVIRONMENT=development
PROJECT_NAME="Bangladesh Citizen Report Platform"
VERSION="0.1.0"
LOG_LEVEL=INFO

# OpenAPI / Swagger Documentation (Defaults to enabled in dev/staging, disabled in production)
# ENABLE_DOCS=false

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# Security: In production, generate a secure random 32+ character hex string
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# PostgreSQL Async Connection String
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# For managed SSL PostgreSQL (e.g. AWS RDS, Supabase, Neon, Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@db.example.com:5432/citizen_report_db?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citizen_report_db

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=10

# ------------------------------------------------------------------------------
# 4. CLOUD OBJECT STORAGE CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# STORAGE_BACKEND: "local" (default filesystem) or "s3" (AWS S3, Cloudflare R2, MinIO, Wasabi)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage

# S3 Configuration (Required if STORAGE_BACKEND=s3)
STORAGE_BUCKET=citizen-report-evidence
STORAGE_ENDPOINT=https://your-s3-endpoint.example.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder

# Upload Constraints (in bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=52428800
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_MEDIA_PER_REPORT=10

# ------------------------------------------------------------------------------
# 5. CORS ALLOWED ORIGINS (Server-Only)
# ------------------------------------------------------------------------------
# Comma-separated or JSON list of authorized frontend URLs.
# In production, specify your exact frontend domain(s). Wildcard '*' is forbidden with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN BOOTSTRAP (Server-Only, Optional for CLI Setup)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@citizenreport.gov.bd
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password
ADMIN_NAME="Lead Administrator"

# ------------------------------------------------------------------------------
# 7. FRONTEND PUBLIC CLIENT CONFIGURATION (Browser-Accessible)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

