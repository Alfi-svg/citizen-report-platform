# ===================================================
# Bangladesh Citizen Report Platform — Environment Config
# ===================================================

# Environment mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Bangladesh Citizen Report Platform"
VERSION="0.1.0"

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citizen_report_db

# Cloud Object Storage & Media Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
STORAGE_BUCKET=citizen-report-evidence
STORAGE_ENDPOINT=https://your-s3-endpoint.example.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your-storage-access-key-placeholder
STORAGE_SECRET_KEY=your-storage-secret-key-placeholder

# Evidence Size Limits (in bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=52428800
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_MEDIA_PER_REPORT=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
