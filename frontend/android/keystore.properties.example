# ==============================================================================
# Bangladesh Citizen Report — Android Release Signing Configuration (Template)
# ==============================================================================
# DO NOT COMMIT YOUR REAL CREDENTIALS OR KEYSTORE TO VERSION CONTROL.
# Copy this file to 'keystore.properties' (which is gitignored) or set the corresponding
# environment variables in your CI/CD build environment.
#
# Environment Variable Alternates:
#   ANDROID_KEYSTORE_PATH       -> storeFile
#   ANDROID_KEYSTORE_PASSWORD   -> storePassword
#   ANDROID_KEY_ALIAS           -> keyAlias
#   ANDROID_KEY_PASSWORD        -> keyPassword
# ==============================================================================

storeFile=release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=bangladeshcitizenreport
keyPassword=YOUR_KEY_PASSWORD
