# ==============================================================================
# Bangladesh Citizen Report Platform — Frontend Environment Configuration
# ==============================================================================
# Publicly accessible client-side variables bundled into the frontend application.
# NEVER place backend server secrets, DB passwords, or S3 access keys in this file.

# Backend API Base URL (e.g., https://api.citizenreport.gov.bd/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend Public Web URL (e.g., https://citizenreport.gov.bd)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Real-time traffic tile overlay URL for 3D/2D Road Safety Map
# Example: https://tiles.example.com/traffic/{z}/{x}/{y}.png
# If omitted, vector building extrusions and safety layers operate normally without traffic raster tiles.
NEXT_PUBLIC_TRAFFIC_TILE_URL=

# Optional: Open Source Routing Machine (OSRM) server URL for Safe Route navigation
# Default fallback: https://router.project-osrm.org
# For self-hosted high-throughput instances, specify your custom OSRM backend URL (e.g., https://osrm.yourdomain.com)
NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
